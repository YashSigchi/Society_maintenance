DATABASE_URL="postgresql://postgres:postgres@localhost:5432/societyhub?schema=public"
JWT_SECRET="your_super_secret_jwt_key_here"
PORT=4000

# SMTP email (set MAIL_ENABLED=true to send)
MAIL_ENABLED=false
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=""
MAIL_PASSWORD=""
MAIL_FROM=noreply@societyhub.com

# Overdue automation (hours, configurable without code changes)
COMPLAINT_OVERDUE_HOURS=48

# Email Integration (Resend)
RESEND_API_KEY=""
EMAIL_FROM="updates@societyhub.com"

# Default admin (used only by npm run seed — never put this in frontend code)
ADMIN_SEED_EMAIL="admin@societyhub.com"
ADMIN_SEED_PASSWORD="ChangeMeNow!123"

# Cloudinary Integration (Image Uploads)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
